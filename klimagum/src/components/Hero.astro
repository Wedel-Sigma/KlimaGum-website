
---
import { site, mapsUrl } from "../data/site";
---

<section
  id="start"
  class="scroll-mt-24 mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:py-28"
>
  <!-- Lewa kolumna -->
  <div>
    <p
      class="mb-4 font-semibold uppercase tracking-wider text-emerald-500"
    >
      Wulkanizacja i serwis samochodowy
    </p>

    <h1
      class="mb-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
    >
      Twój samochód
      <br class="hidden sm:block" />
      <span class="text-emerald-500">
        w dobrych rękach.
      </span>
    </h1>

    <p
      class="mb-8 max-w-xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400"
    >
      Lokalny warsztat samochodowy w Grębocinie.
      Zadbaj o swój samochód bez zbędnych komplikacji.
      Skontaktuj się z nami i umów dogodny termin.
    </p>

    <!-- Przyciski -->
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
      <a
        href="#kontakt"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-emerald-700 sm:w-auto"
      >
        <span class="material-symbols-rounded" aria-hidden="true">
          calendar_month
        </span>
        Umów wizytę
      </a>

      <a
        href="#uslugi"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-zinc-300 px-6 py-3 font-semibold transition-colors hover:bg-zinc-100 sm:w-auto dark:border-zinc-700 dark:hover:bg-zinc-800"
      >
        Zobacz usługi
        <span class="material-symbols-rounded" aria-hidden="true">
          arrow_forward
        </span>
      </a>
    </div>
  </div>

  <!-- Prawa kolumna -->
  <div
    class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-lg sm:p-8 dark:border-zinc-800 dark:bg-zinc-900"
  >
    <h2 class="mb-7 text-2xl font-bold">
      Zapraszamy do Klima<span class="text-emerald-500">Gum</span>
    </h2>

    <div class="space-y-6">

      <!-- Lokalizacja -->
      <div class="flex items-start gap-4">
        <span
          class="material-symbols-rounded rounded-xl bg-emerald-500/10 p-3 text-3xl text-emerald-500"
          aria-hidden="true"
        >
          location_on
        </span>

        <div>
          <h3 class="mb-1 font-semibold">Lokalizacja</h3>
          <address
            class="not-italic leading-relaxed text-zinc-600 dark:text-zinc-400"
          >
            {site.address.street}<br />
            {site.address.city}
          </address>
        </div>
      </div>

      <!-- Godziny otwarcia -->
      <div class="flex items-start gap-4">
        <span
          class="material-symbols-rounded rounded-xl bg-emerald-500/10 p-3 text-3xl text-emerald-500"
          aria-hidden="true"
        >
          schedule
        </span>

        <div>
          <h3 class="mb-1 font-semibold">Godziny otwarcia</h3>

          <div
            class="leading-relaxed text-zinc-600 dark:text-zinc-400"
          >
            {site.hours.map((entry) => (
              <p>{entry.days}: {entry.time}</p>
            ))}
          </div>
        </div>
      </div>

      <!-- Telefon -->
      <div class="flex items-start gap-4">
        <span
          class="material-symbols-rounded rounded-xl bg-emerald-500/10 p-3 text-3xl text-emerald-500"
          aria-hidden="true"
        >
          call
        </span>

        <div>
          <h3 class="mb-1 font-semibold">Kontakt telefoniczny</h3>

          <a
            href={`tel:${site.phone.replace(/\s+/g, "")}`}
            class="text-zinc-600 transition-colors hover:text-emerald-500 dark:text-zinc-400"
          >
            {site.phone}
          </a>
        </div>
      </div>

    </div>

    <!-- Dojazd -->
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-emerald-700"
    >
      <span
        class="material-symbols-rounded"
        aria-hidden="true"
      >
        directions
      </span>
      Wyznacz trasę
    </a>
  </div>
</section>
