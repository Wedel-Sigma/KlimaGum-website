
---
const links = [
  { href: "#start", label: "Start" },
  { href: "#uslugi", label: "Usługi" },
  { href: "#o-nas", label: "O nas" },
  { href: "#kontakt", label: "Kontakt" },
];
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">

    <!-- Logo -->
    <a href="#start" class="flex shrink-0 items-center" aria-label="KlimaGum – strona główna">
      <img
        src="/images/logo-light.png"
        alt=""
        class="block w-36 h-auto sm:w-44 dark:hidden"
      />

      <img
        src="/images/logo-dark.png"
        alt=""
        class="hidden w-36 h-auto sm:w-44 dark:block"
      />
    </a>

    <!-- Nawigacja desktopowa -->
    <nav
      aria-label="Nawigacja główna"
      class="hidden items-center gap-6 text-sm font-medium md:flex"
    >
      {links.map((link) => (
        <a href={link.href} class="transition-colors hover:text-emerald-500">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Przyciski -->
    <div class="flex items-center gap-2">

      <!-- Zmiana motywu -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Włącz jasny motyw"
        class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-zinc-300 p-2 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-800 lg:px-3"
      >
        <span
          id="theme-icon"
          class="material-symbols-rounded"
          aria-hidden="true"
        >light_mode</span>

        <span id="theme-label" class="hidden text-sm lg:inline">
          Jasny motyw
        </span>
      </button>

      <!-- Hamburger -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="Otwórz menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="inline-flex cursor-pointer items-center rounded-lg border border-zinc-300 p-2 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-800 md:hidden"
      >
        <span
          id="menu-icon"
          class="material-symbols-rounded"
          aria-hidden="true"
        >menu</span>
      </button>
    </div>
  </div>

  <!-- Rozwijane menu mobilne -->
  <div
    id="mobile-menu"
    inert
    class="pointer-events-none absolute inset-x-0 top-full grid grid-rows-[0fr] bg-white opacity-0 shadow-lg transition-[grid-template-rows,opacity] duration-300 ease-in-out motion-reduce:transition-none md:hidden dark:bg-zinc-900 dark:border-zinc-700"
    >
    <div class="min-h-0 overflow-hidden">
      <nav
        aria-label="Nawigacja mobilna"
        class="flex flex-col gap-1 border-t border-zinc-200 px-6 py-3 dark:border-zinc-800"
      >
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-3 font-medium transition-colors hover:bg-zinc-100 hover:text-emerald-500 dark:hover:bg-zinc-800"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  
// Przełączanie motywu
const themeButton = document.querySelector<HTMLButtonElement>("#theme-toggle");
const themeIcon = document.querySelector<HTMLElement>("#theme-icon");
const themeLabel = document.querySelector<HTMLElement>("#theme-label");

const systemTheme = window.matchMedia(
  "(prefers-color-scheme: dark)"
);

function updateTheme() {
  const isDark = document.documentElement.classList.contains("dark");

  if (themeIcon) {
    themeIcon.textContent = isDark ? "light_mode" : "dark_mode";
  }

  if (themeLabel) {
    themeLabel.textContent = isDark ? "Jasny motyw" : "Ciemny motyw";
  }

  themeButton?.setAttribute(
    "aria-label",
    isDark ? "Włącz jasny motyw" : "Włącz ciemny motyw"
  );
}

updateTheme();

// Ręczna zmiana motywu
themeButton?.addEventListener("click", () => {
  const isDark = document.documentElement.classList.toggle("dark");

  document.documentElement.style.colorScheme =
    isDark ? "dark" : "light";

  localStorage.setItem(
    "klimagum-theme",
    isDark ? "dark" : "light"
  );

  updateTheme();
});

// Automatyczna reakcja na zmianę motywu urządzenia
systemTheme.addEventListener("change", (event) => {
  const savedTheme = localStorage.getItem("klimagum-theme");

  // Ręczny wybór użytkownika ma pierwszeństwo
  if (savedTheme === "light" || savedTheme === "dark") {
    return;
  }

  document.documentElement.classList.toggle(
    "dark",
    event.matches
  );

  document.documentElement.style.colorScheme =
    event.matches ? "dark" : "light";

  updateTheme();
});


  // Menu mobilne
  const menuButton = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const menuIcon = document.querySelector<HTMLElement>("#menu-icon");

  let menuOpen = false;

  function setMenu(open: boolean) {
    if (!menu || !menuButton || !menuIcon) return;

    menuOpen = open;

    menu.classList.toggle("grid-rows-[1fr]", open);
    menu.classList.toggle("grid-rows-[0fr]", !open);
    menu.classList.toggle("opacity-100", open);
    menu.classList.toggle("opacity-0", !open);
    menu.classList.toggle("pointer-events-auto", open);
    menu.classList.toggle("pointer-events-none", !open);
    menu.classList.toggle("dark:border-b", open);


    menu.inert = !open;

    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute(
      "aria-label",
      open ? "Zamknij menu" : "Otwórz menu"
    );

    menuIcon.textContent = open ? "close" : "menu";
  }

  menuButton?.addEventListener("click", () => {
    setMenu(!menuOpen);
  });

  // Zamykanie po wybraniu sekcji
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  // Zamykanie klawiszem Escape
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
</script>
