
---

import { site, mapsUrl } from "../data/site";

---

<section
  id="kontakt"
  class="scroll-mt-24 bg-zinc-100 py-20 dark:bg-zinc-900"
>
  <div class="mx-auto max-w-6xl px-6">

    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold sm:text-4xl">
        Kontakt i dojazd
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400">
        Skontaktuj się z nami lub odwiedź nasz warsztat.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">

      <!-- Dane kontaktowe -->
      <div class="space-y-6 rounded-2xl border border-zinc-200 bg-white p-8 dark:border-zinc-800 dark:bg-zinc-950">

        <div class="flex items-start gap-4">
          <span class="material-symbols-rounded text-3xl text-emerald-500">
            call
          </span>
          <div>
            <h3 class="mb-1 font-semibold">Telefon</h3>
            <a
              href={`tel:${site.phone.replace(/\s/g, "")}`}
              class="text-zinc-600 transition-colors hover:text-emerald-500 dark:text-zinc-400"
            >
              {site.phone}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="material-symbols-rounded text-3xl text-emerald-500">
            location_on
          </span>
          <div>
            <h3 class="mb-1 font-semibold">Adres</h3>
            <address class="not-italic text-zinc-600 dark:text-zinc-400">
              {site.address.street}<br />
              {site.address.city}
            </address>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="material-symbols-rounded text-3xl text-emerald-500">
            schedule
          </span>
          <div>
            <h3 class="mb-1 font-semibold">Godziny otwarcia</h3>
              <div class="text-zinc-600 dark:text-zinc-400">
                {site.hours.map((entry) => (
                  <p>
                    {entry.days}: {entry.time}
                  </p>
                ))}
              </div>
          </div>
        </div>

      </div>

      <!-- Dojazd -->
      <div class="flex flex-col justify-between gap-8 rounded-2xl border border-zinc-200 bg-white p-8 dark:border-zinc-800 dark:bg-zinc-950">
        <div>
          <span class="material-symbols-rounded mb-4 text-5xl text-emerald-500">
            map
          </span>
          <h3 class="mb-3 text-2xl font-bold">
            Jak do nas dojechać?
          </h3>
          <p class="text-zinc-600 dark:text-zinc-400">
            Znajdziesz nas w Grębocinie, niedaleko Torunia.
            Otwórz lokalizację w Google Maps.
          </p>
        </div>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-6 py-3 font-semibold text-white hover:bg-emerald-700"
        >
          <span class="material-symbols-rounded" aria-hidden="true">
            directions
          </span>
          Otwórz Google Maps
        </a>
      </div>

    </div>
  </div>
</section>
